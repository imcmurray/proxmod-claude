-/// Deterministic x86-64 `struct sysinfo`: no host counters are exposed and
-/// `mem_unit = 1` keeps libc's page calculations well-defined.
-pub fn virtual_sysinfo() -> [u8; 112] {
+/// Deterministic x86-64 `struct sysinfo`.
+///
+/// Host uptime, load, swap, and process counts stay zero. `totalram` and
+/// `freeram` are the recipe memory in bytes (`mem_unit` is 1), so glibc's
+/// `_SC_PHYS_PAGES` is `total_bytes / page_size`. A zero `totalram` makes that
+/// value 0, and systemd 257 aborts in `physical_memory()` on the assertion.
+pub fn virtual_sysinfo(total_bytes: u64) -> [u8; 112] {
     let mut info = [0u8; 112];
+    info[32..40].copy_from_slice(&total_bytes.to_ne_bytes());
+    info[40..48].copy_from_slice(&total_bytes.to_ne_bytes());
     info[104..108].copy_from_slice(&1u32.to_ne_bytes());
     info
 }
